{
  "name": "brain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "fixtures:load": "tsx --env-file=.env.local scripts/load-fixtures.mts",
    "eval": "tsx scripts/eval.mts",
    "eval:answers": "tsx --env-file=.env.local scripts/eval-answers.mts",
    "db:local": "tsx scripts/local-db.mts",
    "auth:invite": "tsx scripts/invite.mts",
    "secrets:rotate": "tsx scripts/rotate-secrets.mts",
    "reembed": "tsx --env-file=.env.local scripts/reembed.mts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "2.0.74",
    "@ai-sdk/openai": "4.0.93",
    "@ai-sdk/openai-compatible": "^3.0.68",
    "@ai-sdk/react": "^4.0.141",
    "@vercel/functions": "3.10.1",
    "ai": "^7.0.138",
    "border-beam": "1.4.1",
    "drizzle-orm": "^0.45.4",
    "fflate": "0.8.2",
    "imapflow": "2.10.0",
    "next": "16.4.3",
    "nodemailer": "10.3.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@electric-sql/pglite-pgvector": "0.0.10",
    "@electric-sql/pglite-socket": "0.2.12",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
