# Neon Postgres (owner connection; user requests drop to the alro_app role via withScope).
# Locally: `npm run db:local`, then postgres://postgres@127.0.0.1:54329/postgres
# and DATABASE_POOL_MAX=1 (the local server is a single session).
DATABASE_URL=
DATABASE_POOL_MAX=

# OpenAI directly (takes priority over AI Gateway; an explicit ALRO_LLM_BASE_URL, below, takes priority over both). Model ids below are the defaults; override with ALRO_*_MODEL.
OPENAI_API_KEY=
# Defaults are the cheapest that hold up on `npm run eval:answers`. For better answers: ALRO_ANSWER_MODEL=gpt-6.1-terra
# ALRO_SCREEN_MODEL=gpt-6-luna
# ALRO_EXTRACT_MODEL=gpt-6-luna
# ALRO_ANSWER_MODEL=gpt-6-luna
# Knowledge-graph extraction over every chunk; defaults to the extract model.
# ALRO_GRAPH_MODEL=gpt-6-luna
# ALRO_EMBEDDING_MODEL=text-embedding-3-small

# Embeddings from a separate endpoint, whatever the chat provider. Local and free with Ollama:
#   ollama pull qwen3-embedding:0.6b && ollama serve
# Every stored vector must come from one model: switching means re-indexing (clear chunks.embedding).
# ALRO_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# ALRO_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Vercel AI Gateway. On Vercel, OIDC is used instead and this can stay empty.
AI_GATEWAY_API_KEY=

# Optional model overrides (AI Gateway model ids). Embeddings must be 1024-dimensional.
# ALRO_SCREEN_MODEL=anthropic/claude-haiku-5.5
# ALRO_EXTRACT_MODEL=anthropic/claude-sonnet-5.5
# ALRO_ANSWER_MODEL=anthropic/claude-sonnet-5.5
# ALRO_EMBEDDING_MODEL=voyage/voyage-3.5

# Encrypts the connector tokens and sign-ins ALRO stores (AES-256-GCM). Required to connect any source.
# Generate once with: openssl rand -base64 32. Losing it means reconnecting sources.
ALRO_SECRET_KEY=
# To rotate: move the old key here, set a new ALRO_SECRET_KEY, run `npm run secrets:rotate`, then remove this.
# ALRO_SECRET_KEY_PREVIOUS=

# Sign-in sources. Register one OAuth app per provider and add the redirect URL <ALRO_APP_URL>/api/oauth/callback.
# Google (Gmail, Calendar, Meet, Drive, Sheets): console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web).
#   Enable the Gmail, Calendar, Drive, Sheets and Google Meet REST APIs on the project.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Microsoft (Outlook, Outlook Calendar, Teams, Teams channels, OneDrive, SharePoint): entra.microsoft.com → App registrations.
#   Teams channels need an admin to grant consent once for the organisation.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# Xero (live accounting lookups): developer.xero.com → My Apps → Web app.
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# QuickBooks Online: developer.intuit.com → Dashboard → Create an app (Accounting scope).
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENVIRONMENT=sandbox
# Everything else (Slack, Zoom, Pipedrive, Zoho, Salesforce, Freshdesk, Intercom, Stripe, Razorpay, Shopify, ...)
# is connected in Settings → Sources with a key or token from that app; nothing to set here.

# Ask the agent from messaging apps (Settings → Messaging). Set up the ones you use.
# WhatsApp Business Cloud API: webhook URL <ALRO_APP_URL>/api/channels/whatsapp, subscribe to "messages".
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_DISPLAY_NUMBER=+91…
# Telegram: create a bot with @BotFather, then point it here:
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook" -d url=<ALRO_APP_URL>/api/channels/telegram -d secret_token=$TELEGRAM_WEBHOOK_SECRET
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_BOT_NAME=
# Slack DMs: a Slack app with chat:write, im:history and files:read, Events API URL <ALRO_APP_URL>/api/channels/slack, event message.im.
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# Microsoft Teams: create an Azure Bot (portal.azure.com → Azure Bot), messaging endpoint <ALRO_APP_URL>/api/channels/teams,
# enable the Microsoft Teams channel, then download the Teams app from Settings → Messaging and upload it in Teams.
# MICROSOFT_BOT_APP_ID=
# MICROSOFT_BOT_APP_PASSWORD=
# Single-tenant bots (the default for new Azure Bots): the tenant id.
# MICROSOFT_BOT_TENANT_ID=

# The agent team: the most model tokens one department run may use (lead plus specialists). Default 150000.
# ALRO_TEAM_TOKEN_BUDGET=150000

# Speech-to-text for voice notes and the chat's Speak button (uses OPENAI_API_KEY).
# Photos and PDFs sent to the bot or uploaded are read by the answer model, so it must accept images and files.
# ALRO_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Email: morning briefs, reminders, invitations, password resets and sign-in links. Without a sender
# they stay in the app (and sign-in links can't be sent). Either a mailbox's SMTP server, used first if set:
#   Hostinger: smtp.hostinger.com, port 465. Google Workspace: smtp.gmail.com, 465, with an app password.
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true    (default: true on port 465, STARTTLS otherwise)
# SMTP_USER=hello@yourdomain.com
# SMTP_PASSWORD=
# ...or Resend (free tier):
# RESEND_API_KEY=
# ALRO_EMAIL_FROM=ALRO <brief@yourdomain.com>
# Public address of this deployment: used in emails and as the base of sign-in and webhook URLs.
# Required in production: invitation and reset links are never built from the request's own Host header.
# ALRO_APP_URL=https://your-alro-url

# Where to post an alert when a background job keeps failing, a source loses access or a retry gives up.
# Any Slack-compatible incoming webhook ({"text": "..."}). Admins also see these on the Health page.
# ALRO_ALERT_WEBHOOK_URL=

# Vercel Cron sends this as a bearer token to /api/cron/*. Required in production.
CRON_SECRET=

# Sign-in. Always required in production. In development the app acts as the member below
# without signing in, unless ALRO_AUTH=on.
ALRO_DEV_USER_EMAIL=rohan@alro.ai
# ALRO_AUTH=on
# Who may create a company: by default only the very first one on a fresh deployment (then people join by
# invitation). "open" lets anyone sign up (a hosted, multi-company deployment): the email address is confirmed by
# a link first (needs RESEND_API_KEY) and single sign-on is switched off. "closed" never.
# ALRO_SIGNUP=open
# First sign-in for data loaded before sign-in existed: npm run auth:invite -- you@company.com owner
#
# Signing in without a password: "Continue with Google / Microsoft" (the apps above, once the redirect URL below is
# added to them) and emailed one-time sign-in links (need an email sender, above). Both let in members and people
# with a live invitation; the first owner can also create the company with Google or Microsoft.
#
# Single sign-on (optional). Any OpenID Connect provider: Okta, Microsoft Entra, Google Workspace, Auth0, Keycloak.
# Register the redirect URL <ALRO_APP_URL>/api/auth/sso/callback. The Google and Microsoft apps above also work
# for sign-in once that redirect URL is added to them (Microsoft only with MICROSOFT_TENANT_ID set to your tenant).
# OIDC_ISSUER=https://your-company.okta.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Okta

# Any OpenAI-compatible endpoint (local Ollama, OpenRouter, ...). When set, it is used instead of OpenAI and AI Gateway.
# Fully local: ollama pull qwen3:4b (tool calling works; slow on a laptop, a few minutes per agent answer).
# ALRO_LLM_BASE_URL=http://localhost:11434/v1
# ALRO_LLM_API_KEY=
# ALRO_SCREEN_MODEL=qwen3:4b
# OpenRouter's free models (no cost; rate-limited, and capped per day without credits on the account):
#   ALRO_LLM_BASE_URL=https://openrouter.ai/api/v1, ALRO_LLM_API_KEY=sk-or-…, every ALRO_*_MODEL set to a ":free" id.
# Free models that are busy are skipped for the next in this list (OpenRouter allows 3 in total, the main one included):
# ALRO_LLM_FALLBACK_MODELS=particle-ai/particle-1:free,inclusionai/ling-3.2-flash:free
# Refuse to start if any model id isn't a free one:
# ALRO_FREE_MODELS_ONLY=true
# ALRO_EMBEDDING_MODEL=qwen3-embedding:0.6b
